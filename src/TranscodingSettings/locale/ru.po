#: ../backend.py:71
#, python-format
msgid "%s cannot listen on transcoding port %d."
msgstr "%s не может прослушивать порт транскодирования %d."

#. XML context: item attribute 'description'
#: ../setup.xml:61
msgid "AAC audio bitrate in kbit/s for the Dreamsource encoder. The generic port-8001 pipeline does not expose an audio-bitrate control and therefore keeps the hardware encoder's AAC bitrate."
msgstr "Битрейт аудио AAC в кбит/с для кодировщика Dreamsource. Стандартный конвейер port-8001 не предоставляет возможности управления битрейтом аудио и поэтому сохраняет битрейт AAC аппаратного кодировщика."

#: ../plugin.py:39 ../plugin.py:115
msgid "Advanced"
msgstr "Продвинутый"

#. XML context: item attribute 'description'
#: ../setup.xml:36
msgid "Allow encoder 0 to choose bitrate or frame-rate behaviour automatically. This option is shown only when the driver exports an automode node."
msgstr "Разрешить кодировщику 0 автоматически выбирать режим работы: битрейт или частоту кадров. Эта опция отображается только в том случае, если драйвер экспортирует узел автоматического режима."

#. XML context: item attribute 'description'
#: ../setup.xml:51
msgid "Allow encoder 1 to choose automatic bitrate or frame-rate behaviour."
msgstr "Разрешить кодировщику 1 выбирать автоматическое регулирование битрейта или частоты кадров."

#. XML context: item attribute 'description'
#: ../setup.xml:81
msgid "Allow frames to reference pictures from the previous GOP. This can improve compression but may reduce seeking and HLS segment independence."
msgstr "Разрешить кадрам ссылаться на изображения из предыдущей группы кадров. Это может улучшить сжатие, но может снизить независимость от сегментов поиска и HLS."

#. XML context: item attribute 'description'
#: ../setup.xml:49
msgid "Aspect-ratio signalling for encoder 1."
msgstr "Сигнализация соотношения сторон для кодировщика 1."

#. XML context: item attribute 'description'
#: ../setup.xml:34
msgid "Aspect-ratio signalling passed to the encoder. Use the driver default when forced 4:3 or 16:9 signalling produces a distorted picture."
msgstr "Сигналы соотношения сторон передаются кодировщику. Используйте значение по умолчанию драйвера, если принудительная передача сигналов 4:3 или 16:9 приводит к искажению изображения."

#. XML context: item attribute 'description'
#: ../setup.xml:48
msgid "Audio codec used by encoder 1 when supported by its driver."
msgstr "Аудиокодек, используемый кодировщиком 1, если он поддерживается его драйвером."

#. XML context: item attribute 'description'
#: ../setup.xml:33
msgid "Audio codec used by the hardware encoder when the driver exposes this control. HLS/RTSP always uses AAC because enigma2-live555 currently supports AAC audio only."
msgstr "Аудиокодек, используемый аппаратным кодировщиком, когда драйвер предоставляет этот параметр управления. HLS/RTSP всегда использует AAC, поскольку enigma2-live555 в настоящее время поддерживает только аудиоформат AAC."

#: ../configuration.py:173
msgid "Auto (first free)"
msgstr "Автоматический режим (первый бесплатно)"

#. XML context: item attribute 'description'
#: ../setup.xml:6
msgid "Auto is the default and lets every port-8001 request use the first free hardware encoder. Parallel streams can therefore use encoder 0 and encoder 1. Select a fixed encoder only for testing or when a client must always use one physical encoder."
msgstr "Режим «Авто» установлен по умолчанию и позволяет каждому запросу через порт 8001 использовать первый свободный аппаратный кодировщик. Таким образом, параллельные потоки могут использовать кодировщик 0 и кодировщик 1. Выбирайте фиксированный кодировщик только для тестирования или когда клиенту всегда необходимо использовать один физический кодировщик."

#: ../configuration.py:247 ../configuration.py:257 ../configuration.py:385
msgid "Automatic"
msgstr "Автоматический"

#: ../configuration.py:450
msgid "Baseline"
msgstr "Исходный уровень"

#: ../plugin.py:115
msgid "Basic"
msgstr "Базовый"

#: ../configuration.py:106
msgid "Best"
msgstr "Лучший"

#. XML context: item attribute 'description'
#: ../setup.xml:8
msgid "Choose a ready-to-use quality profile. Values are adapted to the choices exported by encoder 0. Select Custom to edit the individual settings in Advanced view."
msgstr "Выберите готовый профиль качества. Значения адаптируются к параметрам, экспортированным кодировщиком 0. Выберите «Пользовательский», чтобы отредактировать отдельные настройки в расширенном режиме."

#. XML context: item attribute 'description'
#: ../setup.xml:11
msgid "Choose an independent quality profile for encoder 1. This does not copy settings from encoder 0."
msgstr "Выберите независимый профиль качества для кодировщика 1. При этом настройки кодировщика 0 не копируются."

#. XML context: item attribute 'description'
#: ../setup.xml:55
msgid "Codec level for encoder 1."
msgstr "Уровень кодека для кодировщика 1."

#. XML context: item attribute 'description'
#: ../setup.xml:40
msgid "Codec level limits resolution, frame rate and bitrate. A level that is too low for the selected values can prevent the stream from starting."
msgstr "Ограничения уровня кодека касаются разрешения, частоты кадров и битрейта. Слишком низкий уровень по сравнению с выбранными значениями может помешать запуску потока."

#. XML context: item attribute 'description'
#: ../setup.xml:39
msgid "Codec profile exported by the driver. Invalid profile, codec and level combinations can produce a black screen; keep the default when unsure."
msgstr "Профиль кодека экспортируется драйвером. Недопустимые комбинации профиля, кодека и уровня могут привести к черному экрану; если вы не уверены, оставьте значение по умолчанию."

#. XML context: item attribute 'description'
#: ../setup.xml:54
msgid "Codec profile for encoder 1. Keep the default when the supported combinations are unknown."
msgstr "Профиль кодека для кодировщика 1. Оставьте значение по умолчанию, если поддерживаемые комбинации неизвестны."

#. XML context: item attribute 'description'
#: ../setup.xml:60
msgid "Codec used by HLS and RTSP. Only H.264 and H.265 are accepted by the current live server; Dreamsource devices are limited to H.264."
msgstr "Кодек, используемый HLS и RTSP. Текущий сервер поддерживает только H.264 и H.265; устройства Dreamsource ограничены использованием H.264."

#: ../plugin.py:26
msgid "Configure hardware transcoding, HLS and RTSP"
msgstr "Настройка аппаратного транскодирования, HLS и RTSP"

#: ../configuration.py:108
msgid "Custom"
msgstr "Пользовательский"

#. XML context: item attribute 'description'
#: ../setup.xml:3
msgid "Enable the receiver's hardware encoder and allow OpenWebif to create reduced-bandwidth streams. Disable this option when the encoder must not be used."
msgstr "Включить аппаратный кодер приемника и разрешить OpenWebif создавать потоки с уменьшенной пропускной способностью. Отключите этот параметр, если использование кодера недопустимо."

#. XML context: item attribute 'text'
#: ../setup.xml:3
msgid "Enable transcoding"
msgstr "Включить транскодирование"

